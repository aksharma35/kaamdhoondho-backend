# Copy this file to .env and fill in the values.

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Comma-separated list of allowed origins for CORS (use * to allow all in development)
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaamdhoondho?schema=public

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
